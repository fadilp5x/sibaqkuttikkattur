# SIBAQ KUTTIKKATTUR — server configuration
# Copy to .env and adjust before running in production.
# The dev server auto-creates a .env with a generated secret if one is missing.

PORT=3001

# Admin bootstrap (used only the first time the database is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# Session signing secret — MUST be a long random string in production
SESSION_SECRET=please-generate-a-long-random-string
